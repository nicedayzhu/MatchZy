<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SwiftlyS2.CS2">
        <HintPath>..\..\..\swiftlys2\managed\build\Release\SwiftlyS2\SwiftlyS2.CS2.dll</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Dapper" Version="2.1.15" />
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="7.0.13" />
    <PackageReference Include="MySqlConnector" Version="2.3.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="resources/translations/**/*;resources/gamedata/**/*;resources/templates/**/*;resources/config/**/*;resources/spawns/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 将源代码中的 cfg 目录一起发布（例如 cfg/MatchZy/*.cfg） -->
    <Content Include="cfg\**\*.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Exclude unsupported language files -->
    <Content Remove="resources/translations/uz.jsonc" />
  </ItemGroup>
</Project>
